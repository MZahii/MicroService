# NephrosPaidi Environment Configuration
# Copy this file to .env and adjust values for your environment

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=nephros_user
DB_PASSWORD=nephros_pass

# Eureka Configuration
EUREKA_URL=http://localhost:8761/eureka

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080/realms/nephrospaidi

# Optional: Override individual service databases
# USER_SERVICE_DB=nephros_user_service_db
# OPS_SERVICE_DB=nephros_ops_service_db
# PATIENT_SERVICE_DB=nephros_patient_service_db
# CLINICAL_SERVICE_DB=nephros_clinical_service_db
# PHARMACY_SERVICE_DB=nephros_pharmacy_service_db
# PROCEDURE_SERVICE_DB=nephros_procedure_service_db
# COMMUNICATION_SERVICE_DB=nephros_communication_service_db
# CORE_OPS_SERVICE_DB=nephros_core_ops_service_db
